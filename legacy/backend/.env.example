# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/yeep_ngo

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins
CLIENT_URL=http://localhost:5173

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI must exactly match GOOGLE_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Frontend route the API sends the browser to after a successful Google sign-in
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/auth/callback

# Seed admin account (used by `npm run seed`)
SEED_ADMIN_NAME=YEEP Somalia Admin
SEED_ADMIN_EMAIL=admin@yeep.org.so
SEED_ADMIN_PASSWORD=Admin@12345
