# ---------------------------------------------------------------------------
# YEEP Somalia — environment variables
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored. Every variable here is server-only; none are exposed to the
# browser (no NEXT_PUBLIC_* prefix).
# ---------------------------------------------------------------------------

# Public origin of the app (used for password-reset links and absolute metadata URLs)
APP_URL=http://localhost:3000

# --- Database -------------------------------------------------------------
# Local dev (MongoDB running via `docker compose up -d mongo`):
MONGODB_URI=mongodb://localhost:27017/yeep_ngo
# When the app itself runs inside docker-compose, use the service name:
# MONGODB_URI=mongodb://mongo:27017/yeep_ngo

# --- Auth ----------------------------------------------------------------
# Generate a long random string, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Email / SMTP (optional) ------------------------------------------
# Transactional mail (contact, volunteer, event, password reset). If SMTP_HOST/USER/PASS are
# blank, email is silently skipped and nothing else breaks.
#
# Gmail:      host smtp.gmail.com, port 587, user = the address,
#             pass = a Google "App password" (not the account password).
# cPanel/host: use the mailbox host + credentials from your provider.
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true   # set only for port 465 (implicit TLS)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=YEEP Somalia <no-reply@yeep.org.so>
# Where website contact-form messages are emailed (defaults to the support
# address). Password-reset + welcome mails are unaffected by this.
# CONTACT_INBOX=yeepsomalia@gmail.com

# --- Image uploads / ImageKit (optional) ------------------------------
# Media storage + CDN for uploaded images. If unset, uploads fall back to
# inline data URLs stored on the record (fine for dev, not for production).
# Get these from the ImageKit dashboard → Developer options.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# --- Public site extras (optional) -----------------------------------
# Floating WhatsApp button — digits only, with country code. Unset = hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=252611676253
# Privacy-friendly analytics. Set ONE. Unset = no analytics.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yeep.org.so
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js   # self-hosted override
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# --- Scheduled jobs (event reminders) --------------------------------
# Shared secret for /api/cron/*. On Vercel, set CRON_SECRET and the
# platform sends it automatically for vercel.json crons. Elsewhere, call
# the endpoint yourself: GET /api/cron/event-reminders?key=<CRON_SECRET>
CRON_SECRET=
# Hours before an event that the reminder email goes out (default 48).
# REMINDER_LEAD_HOURS=48

# --- Seed admin account (used by `npm run seed`) ----------------------
# Required — the seed script refuses to run without a real password here.
# Pick a strong, unique one; change it after first login.
SEED_ADMIN_NAME=YEEP Somalia Admin
SEED_ADMIN_EMAIL=admin@yeep.org.so
SEED_ADMIN_PASSWORD=
